{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "outDir": "../dist/out-tsc",
        "sourceMap": true,
        "declaration": false,
        "moduleResolution": "node",
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "target": "ES2022",
        "module": "ES2022",
        "typeRoots": ["node_modules/@types"],
        "lib": ["ES2022", "dom"]
    },
    "exclude": ["src/test.ts", "**/*.spec.ts"]
}
