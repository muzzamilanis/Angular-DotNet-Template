name: Mobile CI

on:
  workflow_call:
  push:
    branches: [ main, master, development ]
    paths:
      - 'Mobile/**'
      - '.github/workflows/mobile-ci.yml'
  pull_request:
    branches: [ main, master, development ]
    paths:
      - 'Mobile/**'
      - '.github/workflows/mobile-ci.yml'
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build-and-test:
    name: Build and Test Mobile App
    runs-on: ubuntu-latest
    
    permissions:
      contents: read
    
    defaults:
      run:
        working-directory: ./Mobile/SmartBizApp
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
      
    - name: Setup Node.js
      uses: actions/setup-node@v4
      with:
        node-version: '20.x'
        cache: 'npm'
        cache-dependency-path: './Mobile/SmartBizApp/package-lock.json'
        
    - name: Install dependencies
      run: npm install
      
    - name: Run linter
      run: npm run lint
      continue-on-error: true
      
    - name: Type check
      run: npx tsc --noEmit
      continue-on-error: true
      
    - name: Run tests
      run: npm test -- --watchAll=false
      continue-on-error: true
